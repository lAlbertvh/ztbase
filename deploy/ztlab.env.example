# Боевой конфигурационный файл ZT Lab.
#
# Куда положить на ноутбуке: /etc/ztlab/ztlab.env
# Права:  sudo chown root:ztlab /etc/ztlab/ztlab.env && sudo chmod 640 /etc/ztlab/ztlab.env
#
# Файл читает systemd (EnvironmentFile) и dotenv.
# В git он не попадает: там лежит секрет.

# Обязательно: без этого приложение в production не запустится.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ЗАМЕНИТЬ_НА_СЛУЧАЙНУЮ_СТРОКУ

NODE_ENV=production

# Порт приложения. Наружу не открывается: доступ только через nginx.
PORT=3000

# Адрес, который слушает приложение.
#
# Сейчас это 127.0.0.1, и это осознанный выбор. Приложение попадает
# на VPS через обратный SSH-туннель (см. deploy/ztlab-tunnel.service),
# поэтому наружу из интернета не выставлено вообще ничего: достучаться
# можно только с VPS. Прямой WireGuard для этого не годится — провайдер
# фильтрует его трафик, туннель живёт одну-две минуты и умирает.
#
# Если бы приложение слушало 0.0.0.0, его видела бы вся локальная сеть
# в обход HTTPS и без шифрования.
HOST=127.0.0.1

# Временные файлы при загрузке. С ProtectSystem=strict писать внутрь
# /opt нельзя, поэтому папка лежит рядом с базой.
TMP_UPLOAD_DIR=/var/lib/ztlab/tmp-uploads

# Хранилище содержимого сайта (редактор /admin/content).
CONTENT_DIR=/var/lib/ztlab/content

# Второй слой защиты редактора: логин и пароль поверх входа в приложение.
# Если оставить пустыми, будет работать только сессия администратора.
CONTENT_ADMIN_USER=ztlab
CONTENT_ADMIN_PASS=

# Токен Telegram-бота для уведомлений. Хранится только здесь,
# в репозиторий не попадает. Получить у @BotFather командой /newbot.
TELEGRAM_BOT_TOKEN=

# Айдентификатор чата для уведомлений (числовой, вида -1001234567890).
TELEGRAM_CHAT_ID=

# Сайт работает через HTTPS, поэтому cookie помечается secure.
# Со значением 0 браузер не примет cookie и будет сбрасывать вход.
COOKIE_SECURE=1

# Каталоги с данными вынесены из папки кода, чтобы обновление
# через deploy.sh их не задевало.
DB_DIR=/var/lib/ztlab/database
UPLOAD_DIR=/var/lib/ztlab/uploads

# Кому nginx (на VPS) можно верить при разборе X-Forwarded-For.
# По умолчанию приложение доверяет локальным и частным адресам.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Внешний адрес приложения. В него кодируется QR-код на наряде, чтобы
# камера телефона открывала страницу отметки работ, а не внутренний
# адрес ноутбука. Должен совпадать с адресом, по которому входят.
PUBLIC_ORIGIN=https://www.ztbase.ru

# ------ Хранилище ------
# Пока файлы на диске ноутбука. Переключение на S3 описано в README.md.
STORAGE_BACKEND=local

# ------ Лимиты ------
STORAGE_QUOTA_GB=100

# Предел на один загружаемый файл, в мегабайтах. Защищает диск от
# случайной загрузки огромной модели. 100 МБ хватает сканированию
# в высоком разрешении; уменьшайте, если места мало.
MAX_FILE_MB=100

# Одноразовая миграция со старой базы. В бою не используется — оставьте пустым.
MIGRATION_TEMP_PASSWORD=
