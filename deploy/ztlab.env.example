# Боевой конфигурационный файл ZT Lab.
#
# Куда положить на ноутбуке: /etc/ztlab/ztlab.env
# Права:  sudo chown root:ztlab /etc/ztlab/ztlab.env && sudo chmod 640 /etc/ztlab/ztlab.env
#
# Файл читает systemd (EnvironmentFile) и dotenv.
# В git он не попадает: там лежит секрет.

# Обязательно: без этого приложение в production не запустится.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ЗАМЕНИТЬ_НА_СЛУЧАЙНУЮ_СТРОКУ

NODE_ENV=production

# Порт приложения. Наружу не открывается: доступ только через nginx.
PORT=3000

# Адрес, который слушает приложение.
#
# Приложение и nginx живут на одной машине: наружу открыт только nginx,
# а приложение слушает петлю. Поэтому достучаться можно только с VPS,
# и обойти HTTPS нельзя.
#
# Если бы приложение слушало 0.0.0.0, его видела бы вся локальная сеть
# в обход HTTPS и без шифрования.
HOST=127.0.0.1

# Временные файлы при загрузке. С ProtectSystem=strict писать внутрь
# /opt нельзя, поэтому папка лежит рядом с базой.
TMP_UPLOAD_DIR=/var/lib/ztlab/tmp-uploads

# Хранилище содержимого сайта (редактор /admin/content).
CONTENT_DIR=/var/lib/ztlab/content

# Папка для картинок, загруженных через редактор. Рядом с содержимым,
# а не в /opt: папка кода на сервере доступна только для чтения, и
# обновление приложения не должно затирать загруженное. Раздаётся по
# прежнему адресу /public/content, поэтому старые ссылки работают.
CONTENT_IMG_DIR=/var/lib/ztlab/content/img

# Второй слой защиты редактора: логин и пароль поверх входа в приложение.
# Если оставить пустыми, будет работать только сессия администратора.
CONTENT_ADMIN_USER=ztlab
CONTENT_ADMIN_PASS=

# Токен Telegram-бота для уведомлений. Хранится только здесь,
# в репозиторий не попадает. Получить у @BotFather командой /newbot.
TELEGRAM_BOT_TOKEN=

# Айдентификатор чата для уведомлений (числовой, вида -1001234567890).
TELEGRAM_CHAT_ID=

# Сайт работает через HTTPS, поэтому cookie помечается secure.
# Со значением 0 браузер не примет cookie и будет сбрасывать вход.
COOKIE_SECURE=1

# Каталоги с данными вынесены из папки кода, чтобы обновление
# через deploy.sh их не задевало.
DB_DIR=/var/lib/ztlab/database
UPLOAD_DIR=/var/lib/ztlab/uploads

# Кому nginx (на VPS) можно верить при разборе X-Forwarded-For.
# По умолчанию приложение доверяет локальным и частным адресам.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Внешний адрес приложения. В него кодируется QR-код на наряде, чтобы
# камера телефона открывала страницу отметки работ, а не внутренний
# адрес ноутбука. Должен совпадать с адресом, по которому входят.
PUBLIC_ORIGIN=https://www.ztbase.ru

# ------ Письма ------
# При регистрации письмо уходит на почту, указанную в форме: адрес
# лаборатории, имя и одноразовая ссылка, по которой пароль задаётся
# заново. Сам пароль в письме не пересылается никогда.
#
# Провайдера можно поменять, не трогая код: SMTP_HOST, SMTP_PORT,
# SMTP_USER и SMTP_PASSWORD — это всё, что нужно. Для Mail.ru:
#   SMTP_HOST=smtp.mail.ru
#   SMTP_PORT=465
#   SMTP_SECURE=1
#   SMTP_USER=почта@mail.ru
#   SMTP_PASSWORD=пароль приложения
# Пароль приложения создаётся в настройках ящика; основной пароль
# ящика для отправки не подходит.
#
# Gmail вместо Mail.ru:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=1
#   SMTP_USER=почта@gmail.com
#   SMTP_PASSWORD=пароль приложения Google
# Пароль приложения Google: https://myaccount.google.com/apppasswords
# (нужна двухэтапная аутентификация на https://myaccount.google.com/security).
#
# SMTP_FROM можно не задавать — приложение возьмёт адрес из SMTP_USER.
#
# MAIL_DRY_RUN=1 печатает письма в журнал вместо отправки: удобно
# проверить настройку, не отправляя настоящие письма.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ZT Lab <noreply@ztbase.ru>
# MAIL_DRY_RUN=1

# ------ Хранилище ------
# Файлы лежат на диске сервера. Переключение на S3 описано в README.md.
STORAGE_BACKEND=local

# ------ Лимиты ------
# Лимит хранилища на одну лабораторию, в гигабайтах. Проверяется при
# каждой загрузке: при превышении файл не сохраняется, сотрудник видит
# понятное сообщение. install-vps.sh уменьшает это значение, если оно
# больше диска: на VPS 25 ГБ сюда ставят примерно 20.
STORAGE_QUOTA_GB=100

# Сколько свободного места на диске держать про запас, в гигабайтах.
# Проверяется перед каждой загрузкой, независимо от квоты лаборатории:
# диск общий с системой, базой и бэкапами, и забитый диск встаёт целиком.
# 0 — не держать запас; файл, который физически не влезает, всё равно
# не сохранится.
STORAGE_MIN_FREE_GB=2

# Предел на один загружаемый файл, в мегабайтах. Защищает диск от
# случайной загрузки огромной модели. 100 МБ хватает сканированию
# в высоком разрешении; уменьшайте, если места мало.
MAX_FILE_MB=100

# Одноразовая миграция со старой базы. В бою не используется — оставьте пустым.
MIGRATION_TEMP_PASSWORD=
