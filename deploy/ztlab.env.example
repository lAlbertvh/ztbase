# Боевой конфигурационный файл ZT Lab.
#
# Куда положить на ноутбуке: /etc/ztlab/ztlab.env
# Права:  sudo chown root:ztlab /etc/ztlab/ztlab.env && sudo chmod 640 /etc/ztlab/ztlab.env
#
# Файл читает systemd (EnvironmentFile) и dotenv.
# В git он не попадает: там лежит секрет.

# Обязательно: без этого приложение в production не запустится.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ЗАМЕНИТЬ_НА_СЛУЧАЙНУЮ_СТРОКУ

NODE_ENV=production

# Порт приложения. Наружу не открывается: доступ только через nginx.
PORT=3000

# Адрес, который слушает приложение.
# Это адрес WireGuard на ноутбуке, а не 0.0.0.0:
# иначе приложение будет доступно всей локальной сети в обход HTTPS.
# Узнать:  ip addr show wg0
HOST=10.8.0.2

# Сайт работает через HTTPS, поэтому cookie помечается secure.
# Со значением 0 браузер не примет cookie и будет сбрасывать вход.
COOKIE_SECURE=1

# Каталоги с данными вынесены из папки кода, чтобы обновление
# через deploy.sh их не задевало.
DB_DIR=/var/lib/ztlab/database
UPLOAD_DIR=/var/lib/ztlab/uploads

# Кому nginx (на VPS) можно верить при разборе X-Forwarded-For.
# По умолчанию приложение доверяет локальным и частным адресам.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ------ Хранилище ------
# Пока файлы на диске ноутбука. Переключение на S3 описано в README.md.
STORAGE_BACKEND=local

# ------ Лимиты ------
STORAGE_QUOTA_GB=100

# Одноразовая миграция со старой базы. В бою не используется — оставьте пустым.
MIGRATION_TEMP_PASSWORD=
