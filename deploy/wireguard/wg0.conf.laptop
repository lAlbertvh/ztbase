# Конфигурация WireGuard на НОУТБУКЕ.
#
# Куда положить: /etc/wireguard/wg0.conf
# Владелец и права:  chown root:root /etc/wireguard/wg0.conf && chmod 600 /etc/wireguard/wg0.conf
#
# Ключи берутся из setup-wireguard-vps.sh, который печатает ключ VPS.
# Свой ключ ноутбука создаётся один раз:
#   sudo apt install wireguard
#   sudo wg genkey | sudo tee /etc/wireguard/laptop.key | sudo wg pubkey | sudo tee /etc/wireguard/laptop.pub
#
# Публичный ключ ноутбука (laptop.pub) передаётся на VPS при настройке.
# Приватные ключи не передаются никогда.

[Interface]
# Приватный ключ ноутбука. Впишите содержимое /etc/wireguard/laptop.key
PrivateKey = СЮДА_ПРИВАТНЫЙ_КЛЮЧ_НОУТБУКА

# Адрес ноутбука в VPN-сети. Должен совпадать с тем, что указан
# в AllowedIPs на VPS. По умолчанию 10.8.0.2.
Address = 10.8.0.2/32

# Порт на стороне ноутбука можно не указывать — он поднимется случайный.
# ListenPort = 51821

# НЕ добавляйте сюда DNS: VPN не должен влиять на разрешение имён
# в обычном интернете.

[Peer]
# Публичный ключ VPS. Впишите ключ, напечатанный setup-wireguard-vps.sh
PublicKey = СЮДА_ПУБЛИЧНЫЙ_КЛЮЧ_VPS

# Весь трафик в VPN, кроме обращений к самому сервису:
#  - 0.0.0.0/0        весь интернет через VPN
#  - 10.8.0.0/24      только ноутбук и VPS
#  - 192.168.1.0/24    домашняя сеть роутера
# Рекомендуется только 10.8.0.0/24: VPN используется для связи с VPS,
# а весь обычный интернет идёт напрямую и быстрее.
AllowedIPs = 10.8.0.0/24

# Постоянные подключения: ноутбук засыпает, и без этого Keepalive
# туннель не поднимется сразу при обращении к сайту.
PersistentKeepalive = 25
