<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FF9800">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <link rel="icon" href="/icons/icon-192.png">
    <title><%= order ? 'Наряд ' + order.order_number : 'Новый наряд' %></title>
    <link rel="stylesheet" href="/css/app.css">
    <style>
        * { box-sizing: border-box; }
        body { font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
               margin: 0; background: #f4f5f7; color: #23272f; }
        header { background: #FF9800; color: #fff; padding: 12px 16px;
                 display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
                 position: sticky; top: 0; z-index: 10; }
        header h1 { font-size: 19px; margin: 0; }
        header .who { font-size: 13px; opacity: .9; margin-left: auto; }
        main { max-width: 1000px; margin: 0 auto; padding: 16px 16px 60px; }
        fieldset { background: #fff; border: 1px solid #e2e4e9; border-radius: 8px;
                   margin: 0 0 14px; padding: 14px; }
        legend { font-weight: 600; font-size: 15px; padding: 0 6px; color: #374151; }
        label { display: block; font-size: 13px; color: #4b5563; margin-bottom: 4px; }
        input[type=text], input[type=tel], input[type=email], input[type=date],
        input[type=number], input[type=datetime-local], select, textarea {
            width: 100%; padding: 8px 10px; border: 1px solid #cbd2dc;
            border-radius: 6px; font-size: 15px; font-family: inherit; background: #fff; }
        textarea { min-height: 74px; resize: vertical; }
        .grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
        .row { margin-bottom: 12px; }
        .checks { display: flex; flex-wrap: wrap; gap: 8px 14px; }
        .checks label { display: flex; align-items: center; gap: 5px; margin: 0; font-size: 14px; color: #23272f; }
        .btn { display: inline-block; padding: 9px 16px; border-radius: 6px; border: 1px solid transparent;
               font-size: 14px; cursor: pointer; text-decoration: none; background: #fff; color: #23272f; }
        .btn-primary { background: #2b6cb0; color: #fff; }
        .hint { font-size: 12px; color: #8a93a0; margin-top: 4px; }
        /* Кликабельная формула и список зубов описаны в app.css:
           здесь раньше лежали стили старой серой подсказки. */
        .sticky-save { position: fixed; left: 0; right: 0; bottom: 0; background: #fff;
                       border-top: 1px solid #dfe3e9; padding: 10px 16px; display: flex;
                       gap: 10px; justify-content: flex-end; z-index: 9; }
        .mat-row { display: grid; gap: 8px; grid-template-columns: 2fr .6fr .7fr 2fr auto;
                   margin-bottom: 6px; align-items: center; }
        @media (max-width: 640px) { .mat-row { grid-template-columns: 1fr 1fr; } }
        .con-row { display: grid; gap: 8px; align-items: center;
                   grid-template-columns: minmax(140px, 1.6fr) 110px 90px minmax(120px, 1.2fr) auto;
                   padding: 6px 0; border-bottom: 1px solid #eef0f3; }
        /* Своя строка без привязки к справочнику: две цены вместо одной. */
        .con-row:has(input[name=construction_custom]) {
                   grid-template-columns: minmax(140px, 1.6fr) 100px 100px 90px minmax(120px, 1.2fr) auto; }
        @media (max-width: 720px) {
            .con-row, .con-row:has(input[name=construction_custom]) { grid-template-columns: 1fr 1fr; }
        }
        .con-name { font-weight: 600; }
        .con-price { font-size: 13px; color: #6b7280; }
        input.con-price { font-size: 15px; color: #23272f; }
        .totals { border: 1px solid #e2e4e9; border-radius: 8px; overflow: hidden; }
        .t-row { display: flex; justify-content: space-between; gap: 12px;
                 padding: 7px 10px; font-size: 14px; border-bottom: 1px solid #eef0f3; }
        .t-row:last-child { border-bottom: none; }
        .t-total { background: #f0f7f0; font-weight: 700; }
        .t-muted { color: #6b7280; font-size: 13px; }
    </style>
</head>
<body>
    <header class="app-header">
        <h1><%= order ? 'Наряд ' + order.order_number : 'Новый заказ-наряд' %></h1>
        <span class="who"><%= currentUser %></span>
    </header>

    <form method="post" action="/orders">
        <% if (order) { %><input type="hidden" name="id" value="<%= order.id %>"><% } %>
        <% if (isDentist) { %><input type="hidden" name="stage" value="new"><% } %>

        <main>
            <%# Разделы доступны и отсюда: форму открывают из разных мест,
                и возвращаться к заказ-нарядам кнопкой в шапке было мало. %>
            <%- include('../partials/nav', { active: 'orders', inline: true, currentUser, isDentist }) %>
            <fieldset>
                <legend>Заказчик</legend>
                <div class="grid">
                    <div>
                        <label>Номер наряда <span style="color:#c53030">*</span></label>
                        <input type="text" name="order_number" required maxlength="60"
                               value="<%= order ? order.order_number : '' %>">
                    </div>
                    <%# Клиника выбирается из справочника, а не пишется текстом:
                        написанное руками название не сопоставить с учётными
                        записями врачей, и наряд такой клиники потом не нашёлся
                        бы в её списке. %>
                    <div>
                        <% if (isDentist) { %>
                            <label>Клиника</label>
                            <input type="text" value="<%= myClinic || 'Ваша клиника' %>" readonly>
                        <% } else { %>
                            <label>Клиника</label>
                            <select name="clinic_id">
                                <option value="">— не указана —</option>
                                <% clinics.forEach(function (c) { %>
                                    <option value="<%= c.id %>"
                                        <%= order && String(order.clinic_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
                                <% }) %>
                            </select>
                        <% } %>
                    </div>
                    <div>
                        <label>Заказчик в свободной форме</label>
                        <input type="text" name="customer" maxlength="200"
                               value="<%= order ? order.customer || '' : '' %>">
                    </div>
                    <div>
                        <label>Телефон</label>
                        <input type="tel" name="phone" maxlength="60"
                               value="<%= order ? order.phone || '' : '' %>">
                    </div>
                    <div>
                        <label>E-mail</label>
                        <input type="email" name="email" maxlength="120"
                               value="<%= order ? order.email || '' : '' %>">
                    </div>
                    <div>
                        <label>Пациент / внутренний номер</label>
                        <input type="text" name="patient" maxlength="200"
                               value="<%= order ? order.patient || '' : '' %>">
                    </div>
                    <div>
                        <label>Адрес доставки</label>
                        <input type="text" name="delivery_address" maxlength="300"
                               value="<%= order ? order.delivery_address || '' : '' %>">
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Зубная формула <span style="color:#c53030">*</span></legend>
                <%# Кликабельный ряд вместо ввода номеров. Поле остаётся
                    для переноса с бумажного бланка и служит представлением. %>
                <%- include('../partials/teeth-formula', {
                    value: teethText,
                    catalog,
                    fieldId: 'teeth',
                }) %>
                <div class="hint">Можно нажимать зубы в формуле или вписать номера в поле.
                    Постоянные зубы: 11–18, 21–28, 31–38, 41–48.</div>
            </fieldset>

            <fieldset>
                <legend>Вид работ</legend>
                <div class="row">
                    <label>Тип конструкции</label>
                    <select name="work_kind">
                        <% const curKind = order && order.teeth && order.teeth[0] ? order.teeth[0].kind : ''; %>
                        <% catalog.WORK_KINDS.forEach(w => { %>
                            <option value="<%= w.kind %>" <%= curKind === w.kind ? 'selected' : '' %>><%= w.title %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="grid">
                    <div>
                        <label>Материал</label>
                        <input type="text" name="material" maxlength="120"
                               value="<%= order && order.teeth && order.teeth[0] ? order.teeth[0].material || '' : '' %>">
                    </div>
                    <div>
                        <label>Цвет</label>
                        <select name="color">
                            <option value="">— не указан —</option>
                            <% const curColor = order && order.teeth && order.teeth[0] ? order.teeth[0].color || '' : ''; %>
                            <% catalog.COLOR_SYSTEMS.forEach(c => { %>
                                <option value="<%= c %>" <%= curColor === c ? 'selected' : '' %>><%= c %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
                <div class="row" style="margin-top:12px">
                    <label>Обработка индивидуального абатмента</label>
                    <div class="checks">
                        <% const curAb = order && order.teeth && order.teeth[0] ? (order.teeth[0].abutment || '').split(',') : []; %>
                        <% catalog.ABUTMENT_OPTIONS.forEach(o => { %>
                        <label><input type="checkbox" name="abutment" value="<%= o.key %>" <%= curAb.includes(o.key) ? 'checked' : '' %>> <%= o.title %></label>
                        <% }); %>
                    </div>
                </div>
                <div class="row">
                    <label>Отметки по работе</label>
                    <div class="checks">
                        <% const curFl = order && order.teeth && order.teeth[0] ? (order.teeth[0].flags || '').split(',') : []; %>
                        <% catalog.FRAME_FLAGS.forEach(o => { %>
                        <label><input type="checkbox" name="flags" value="<%= o.key %>" <%= curFl.includes(o.key) ? 'checked' : '' %>> <%= o.title %></label>
                        <% }); %>
                    </div>
                </div>
                <div class="row">
                    <label>Поступило с заказом</label>
                    <div class="checks">
                        <% const curIn = order ? String(order.incoming || '').split(',') : []; %>
                        <% catalog.INCOMING_OPTIONS.forEach(o => { %>
                        <label><input type="checkbox" name="incoming" value="<%= o.key %>" <%= curIn.includes(o.key) ? 'checked' : '' %>> <%= o.title %></label>
                        <% }); %>
                    </div>
                </div>
                <div class="row">
                    <label>Что требуется изготовить</label>
                    <div class="checks">
                        <% const curDel = order ? String(order.delivery || '').split(',') : []; %>
                        <% catalog.DELIVERY_OPTIONS.forEach(o => { %>
                        <label><input type="checkbox" name="delivery" value="<%= o.key %>" <%= curDel.includes(o.key) ? 'checked' : '' %>> <%= o.title %></label>
                        <% }); %>
                    </div>
                </div>
            </fieldset>

<% const curCons = (order && order.constructions) ? order.constructions : [];
   const curDiscount = order ? (Number(order.discount) || 0) : 0; %>
<% if (canDiscount !== false) { %>
              <fieldset>
                  <legend>Скидка и итог</legend>
                <div class="row" style="align-items:flex-start;flex-wrap:wrap;gap:16px">
                    <div>
                        <label>Скидка клинике</label>
                        <div class="checks" id="disc-presets">
                            <% [0, 10, 15, 20, 25, 30, 40, 50, 65].forEach(function (p) { %>
                            <label style="display:inline-flex;align-items:center;gap:4px">
                                <input type="radio" name="discount_preset" value="<%= p %>"
                                       <%= Number(curDiscount) === p ? 'checked' : '' %>>
                                <%= p === 0 ? 'нет' : p + '%' %>
                            </label>
                            <% }); %>
                        </div>
                        <div class="hint" style="margin-top:6px">
                            Своя скидка:
                            <input type="text" name="discount" id="disc-input" inputmode="decimal"
                                   value="<%= curDiscount || '' %>" placeholder="0" style="width:80px;display:inline-block;padding:5px 8px">
                            %
                        </div>
                    </div>
                    <div style="flex:1 1 220px">
                        <label>Итого по конструкциям</label>
                        <div id="totals" class="totals">
                            <div class="t-row"><span>Цена для врача</span><b id="sum-client">0 ₽</b></div>
                            <div class="t-row" id="row-discount" hidden><span>Скидка <span id="lbl-discount"></span></span><b id="sum-discount">0 ₽</b></div>
                            <div class="t-row t-total"><span>К оплате</span><b id="sum-payable">0 ₽</b></div>
                            <div class="t-row t-muted"><span>Себестоимость для техника</span><b id="sum-tech">0 ₽</b></div>
                        </div>
                        <div class="hint" style="margin-top:6px">
                            Скидка уменьшает сумму для врача. Себестоимость для техника
                            не меняется — скидка идёт из маржи лаборатории.
                        </div>
                      </div>
                  </div>
              </fieldset>
              <% } %>
  
              <fieldset>
                  <legend>Конструкции</legend>
                <p class="hint" style="margin:0 0 10px">
                    Выберите, что изготавливается. Можно выбрать несколько —
                    например, съёмную конструкцию на 17,16 и мост из циркона
                    на месте импланта. Выбирать могут и врач, и техник.
                </p>

<div id="cons">
                    <% curCons.forEach(function (c) { %>
                    <div class="mat-row con-row">
                        <input type="hidden" name="construction_id" value="<%= c.construction_id || '' %>">
                        <% if (c.construction_id) { %>
                        <span class="con-name"><%= c.title %></span>
                        <span class="con-price" data-price="<%= c.price === null || c.price === undefined ? '' : c.price %>"
                              data-price-tech="<%= c.price_tech === null || c.price_tech === undefined ? '' : c.price_tech %>"></span>
                        <% } else { %>
                        <input type="text" name="construction_custom" class="con-name" maxlength="200"
                               value="<%= c.title %>" placeholder="Своя конструкция">
                        <% if (canSetPrices !== false) { %>
                        <input type="text" name="construction_custom_price" class="con-price"
                               inputmode="decimal" placeholder="цена, ₽" value="<%= (c.price === null || c.price === undefined) ? '' : c.price %>">
                        <input type="text" name="construction_custom_price_tech" class="con-price"
                               inputmode="decimal" placeholder="себест., ₽" value="<%= (c.price_tech === null || c.price_tech === undefined) ? '' : c.price_tech %>">
                        <% } else { %>
                        <span class="con-price">цена назначит администратор</span>
                        <% } %>
                        <% } %>
                        <input type="number" name="construction_qty" value="<%= c.qty %>" step="0.01" min="0" placeholder="Кол-во" style="flex:0 0 90px">
                        <input type="text" name="construction_material" value="<%= c.material || '' %>" list="mat-catalog" placeholder="Материал" maxlength="120">
                        <button type="button" class="btn" onclick="this.parentElement.remove()">✕</button>
                    </div>
                    <% }); %>
                </div>

                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;margin-top:10px">
                    <div style="flex:2 1 320px">
                        <label>Добавить конструкцию</label>
                        <select id="con-picker">
                            <option value="">— выберите из справочника —</option>
                            <% (constructions || []).forEach(function (g) { %>
                                <optgroup label="<%= g.title %>">
                                    <% g.items.forEach(function (c) { %>
                                          <option value="<%= c.id %>" data-title="<%= c.title %>"
                                                  data-price="<%= c.price === null ? '' : c.price %>"
                                                  data-price-tech="<%= c.price_tech === null || c.price_tech === undefined ? '' : c.price_tech %>">
                                            <%= c.section ? c.section + ' · ' : '' %><%= c.title %><%= c.price === null ? ' (цена не загружена)' : ' — ' + c.price + ' ₽' %>
                                        </option>
                                    <% }); %>
                                </optgroup>
                            <% }); %>
                        </select>
                    </div>
                    <button type="button" class="btn btn-primary" onclick="addCon()">+ Из справочника</button>
                    <button type="button" class="btn" onclick="addOwnCon()">+ Своя конструкция</button>
                </div>

                <% if (!constructions || !constructions.length) { %>
                  <div class="hint" style="margin-top:10px">
                      Справочник пуст — конструкции заведите в админке:
                    <a href="/orders/catalog/constructions">справочник конструкций</a>.
                </div>
                <% } %>
            </fieldset>

            <fieldset>
                <legend>Материалы</legend>
                <datalist id="mat-catalog">
                    <% (materials || []).forEach(function (m) { %>
                    <option value="<%= m.name %>"><%= m.unit || 'шт' %></option>
                    <% }); %>
                </datalist>
                <div id="mats">
                    <% if (order && order.materials.length) { order.materials.forEach(m => { %>
                    <div class="mat-row">
                        <input type="text" name="material_name" value="<%= m.name %>" list="mat-catalog" placeholder="Материал">
                        <input type="number" name="material_qty" value="<%= m.qty %>" step="0.01" min="0" placeholder="Кол-во">
                        <input type="text" name="material_unit" value="<%= m.unit %>" placeholder="ед.">
                        <input type="text" name="material_note" value="<%= m.note || '' %>" placeholder="Примечание">
                        <button type="button" class="btn" onclick="this.parentElement.remove()">✕</button>
                    </div>
                    <% }); } %>
                </div>
                <button type="button" class="btn" style="margin-top:8px" onclick="addMat()">+ Материал</button>
                <% if (materials && materials.length) { %>
                <div class="hint" style="margin-top:10px">
                    Из справочника:
                    <% materials.forEach((m, i) => { %>
                        <a href="#" style="color:#2b6cb0" onclick="fillMat('<%= m.name %>','<%= m.unit %>');return false"><%= m.name %></a><%= i < materials.length-1 ? ', ' : '' %>
                    <% }); %>
                </div>
                <% } %>
            </fieldset>

            <fieldset>
                <legend>Комментарий</legend>
                <div class="row">
                    <label>Описание конструкции и пожелания</label>
                    <textarea name="comment" maxlength="4000"><%= order ? order.comment || '' : '' %></textarea>
                </div>
                <% if (isDentist) { %>
                <div class="row">
                    <label>Комментарий стоматолога для лаборатории</label>
                    <textarea name="dentist_note" maxlength="4000"><%= order ? order.dentist_note || '' : '' %></textarea>
                </div>
                <% } %>
                <div class="row">
                    <label>Комментарий к зубам</label>
                    <input type="text" name="tooth_note" maxlength="1000"
                           value="<%= order && order.teeth && order.teeth[0] ? order.teeth[0].note || '' : '' %>"
                           placeholder="Например: анатомическая форма, плечо 1 мм">
                </div>
            </fieldset>

            <% if (!isDentist) { %>
            <fieldset>
                <legend>Организационное</legend>
                <div class="grid">
                    <div>
                        <label>Этап</label>
                        <select name="stage">
                            <% catalog.STAGES.forEach(s => { %>
                                <option value="<%= s.key %>" <%= order && order.stage === s.key ? 'selected' : '' %>><%= s.title %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div>
                        <label>Взято в работу</label>
                        <input type="datetime-local" name="taken_at"
                               value="<%= order && order.taken_at ? order.taken_at.slice(0,16).replace(' ','T') : '' %>">
                    </div>
                    <div>
                        <label>Обещано клиенту</label>
                        <input type="date" name="promised_at"
                               value="<%= order && order.promised_at ? order.promised_at.slice(0,10) : '' %>">
                    </div>
                    <div>
                        <label>Срочность</label>
                        <select name="priority">
                            <option value="0" <%= order && order.priority ? '' : 'selected' %>>Обычный</option>
                            <option value="1" <%= order && order.priority ? 'selected' : '' %>>Срочный</option>
                        </select>
                    </div>
                </div>
            </fieldset>
            <% } %>
        </main>

        <div class="sticky-save">
            <a class="btn" href="<%= order ? '/orders/' + order.id : '/orders' %>">Отмена</a>
            <button class="btn btn-primary" type="submit">Сохранить наряд</button>
        </div>
    </form>

    <script>
    function addMat(name, qty, unit) {
        const box = document.getElementById('mats');
        const row = document.createElement('div');
        row.className = 'mat-row';
        row.innerHTML =
            '<input type="text" name="material_name" placeholder="Материал" list="mat-catalog" value="' + (name||'') + '">' +
            '<input type="number" name="material_qty" step="0.01" min="0" placeholder="Кол-во" value="' + (qty||1) + '">' +
            '<input type="text" name="material_unit" placeholder="ед." value="' + (unit||'шт') + '">' +
            '<input type="text" name="material_note" placeholder="Примечание">' +
            '<button type="button" class="btn" onclick="this.parentElement.remove()">✕</button>';
        box.appendChild(row);
    }
    function fillMat(name, unit) { addMat(name, 1, unit); }

    // Конструкция добавляется по id из справочника; название берём из
    // data-title выбранной опции и вставляем через textContent, а не
    // innerHTML, чтобы название из справочника не могло разорвать
    // разметку страницы.
    function addCon() {
        const picker = document.getElementById('con-picker');
        if (!picker || !picker.value) { alert('Выберите конструкцию из списка'); return; }
        const opt = picker.options[picker.selectedIndex];

        const box = document.getElementById('cons');
        const row = document.createElement('div');
        row.className = 'mat-row con-row';

        const id = document.createElement('input');
        id.type = 'hidden'; id.name = 'construction_id'; id.value = opt.value;

          const name = document.createElement('span');
          name.className = 'con-name'; name.textContent = opt.dataset.title || opt.text;
  
          // Обе цены едут в data-атрибутах строки, а не в скрытые поля:
          // итог считается на клиенте, а при сохранении сервер всё равно
          // перечитывает справочник, поэтому доверять этим числам нельзя.
          const price = document.createElement('span');
          price.className = 'con-price';
          price.dataset.price = opt.dataset.price || '';
          price.dataset.priceTech = opt.dataset.priceTech || '';
          price.textContent = opt.dataset.price ? opt.dataset.price + ' ₽' : 'цена не загружена';
  
          const qty = document.createElement('input');
        qty.type = 'number'; qty.name = 'construction_qty';
        qty.step = '0.01'; qty.min = '0'; qty.value = '1';
        qty.style.flex = '0 0 90px';

        const material = document.createElement('input');
        material.type = 'text'; material.name = 'construction_material';
        material.maxLength = 120; material.placeholder = 'Материал';

        const del = document.createElement('button');
        del.type = 'button'; del.className = 'btn'; del.textContent = '✕';
        del.onclick = function () { this.parentElement.remove(); };

          row.append(id, name, price, qty, material, del);
          box.appendChild(row);
  
          picker.value = '';
          qty.focus();
          recalc();
      }

    // Своя конструкция: пустой construction_id и свободное название.
    // Такой позиции нет в справочнике, но она сохраняется в наряд так же,
    // как справочниковая, и попадает в учёт и суммы.
    function addOwnCon() {
        const box = document.getElementById('cons');
        const row = document.createElement('div');
        row.className = 'mat-row con-row';

        const id = document.createElement('input');
        id.type = 'hidden'; id.name = 'construction_id'; id.value = '';

        const title = document.createElement('input');
        title.type = 'text'; title.name = 'construction_custom';
        title.maxLength = 200; title.placeholder = 'Своя конструкция';
        title.className = 'con-name';

          // Поля цен есть только у администратора: у врача и техника их
          // нет и в разметке, и в разборе формы, поэтому подделать цену
          // подстановкой поля не получится.
          let priceTech = null;
          if (CAN_SET_PRICES) {
              const price = document.createElement('input');
              price.type = 'text'; price.name = 'construction_custom_price';
              price.inputMode = 'decimal'; price.placeholder = 'цена, ₽';
              price.className = 'con-price';

              priceTech = document.createElement('input');
              priceTech.type = 'text'; priceTech.name = 'construction_custom_price_tech';
              priceTech.inputMode = 'decimal'; priceTech.placeholder = 'себест., ₽';
              priceTech.className = 'con-price';

              row.append(id, title, price, priceTech);
          } else {
              const price = document.createElement('span');
              price.className = 'con-price';
              price.textContent = 'цена назначит администратор';
              row.append(id, title, price);
          }
  
          const qty = document.createElement('input');
        qty.type = 'number'; qty.name = 'construction_qty';
        qty.step = '0.01'; qty.min = '0'; qty.value = '1';
        qty.style.flex = '0 0 90px';

        const material = document.createElement('input');
        material.type = 'text'; material.name = 'construction_material';
        material.maxLength = 120; material.placeholder = 'Материал';
        material.setAttribute('list', 'mat-catalog');

        const del = document.createElement('button');
        del.type = 'button'; del.className = 'btn'; del.textContent = '✕';
        del.onclick = function () { this.parentElement.remove(); };

          row.append(qty, material, del);
          box.appendChild(row);
          title.focus();
          recalc();
      }

      // ── Итоги ────────────────────────────────────────────────────
      // Считаются на клиенте, чтобы администратор не ждал перезагрузки
      // после каждого изменения. Это только предпросмотр: настоящие
      // суммы сервер считает сам из справочника и пересчитывает при
      // сохранении, поэтому подделать итог в браузере нельзя.
      const CAN_SET_PRICES = <%= canSetPrices === false ? 'false' : 'true' %>;

      const rub = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 2 });
      const money = n => rub.format(Math.round(n * 100) / 100) + ' ₽';

      function num(v) {
          const s = String(v == null ? '' : v).trim().replace(/\s/g, '').replace(',', '.');
          if (!s) return null;
          const n = Number(s);
          return Number.isFinite(n) && n >= 0 ? n : null;
      }

      function recalc() {
          let client = 0, tech = 0, missingClient = 0, missingTech = 0;
          document.querySelectorAll('#cons .con-row').forEach(row => {
              const qty = num(row.querySelector('input[name=construction_qty]')?.value) || 0;
              const ownPrice = row.querySelector('input[name=construction_custom_price]');
              const ownTech  = row.querySelector('input[name=construction_custom_price_tech]');
              const ref      = row.querySelector('.con-price[data-price]');
              const c = ownPrice ? num(ownPrice.value) : num(ref?.dataset.price);
              const t = ownTech  ? num(ownTech.value)  : num(ref?.dataset.priceTech);
              if (c === null) missingClient++; else client += c * qty;
              if (t === null) missingTech++;  else tech   += t * qty;
          });

          const d = Math.min(Math.max(num(document.getElementById('disc-input')?.value) || 0, 0), 100);
          const discount = client * d / 100;
          const set = (id, text) => { const el = document.getElementById(id); if (el) el.textContent = text; };

          set('sum-client', money(client));
          set('sum-discount', '−' + money(discount));
          set('sum-payable', money(client - discount));
          set('sum-tech', money(tech));
          const lbl = document.getElementById('lbl-discount');
          if (lbl) lbl.textContent = d ? d + '%' : '';
          const rowD = document.getElementById('row-discount');
          if (rowD) rowD.hidden = !(d > 0);
      }

      // Скидка живёт в поле discount, радиокнопки только подставляют
      // значение в него: иначе сервер получил бы две разные скидки из
      // одной формы и не понял бы, какую применить.
      function setDiscount(v) {
          const input = document.getElementById('disc-input');
          if (input) input.value = v;
          recalc();
      }

      document.addEventListener('DOMContentLoaded', function () {
          recalc();
          document.querySelectorAll('input[name=construction_qty]').forEach(el => el.addEventListener('input', recalc));
          document.querySelectorAll('input[name=construction_custom_price], input[name=construction_custom_price_tech]')
                  .forEach(el => el.addEventListener('input', recalc));
          const disc = document.getElementById('disc-input');
          if (disc) disc.addEventListener('input', function () {
              document.querySelectorAll('input[name=discount_preset]').forEach(r => r.checked = false);
              recalc();
          });
          document.querySelectorAll('input[name=discount_preset]').forEach(r =>
              r.addEventListener('change', function () { setDiscount(r.value); }));
          document.getElementById('cons')?.addEventListener('click', function (ev) {
              if (ev.target.closest('button')) recalc();
          });
      });
      </script>
</body>
</html>
