<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FF9800">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <link rel="icon" href="/icons/icon-192.png">
    <title>Справочник материалов</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
               margin: 0; background: #f4f5f7; color: #23272f; }
        header { background: #FF9800; color: #fff; padding: 12px 16px;
                 display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        header h1 { font-size: 19px; margin: 0; }
        header .who { font-size: 13px; opacity: .9; margin-left: auto; }
        main { max-width: 900px; margin: 0 auto; padding: 16px; }
        .card { background: #fff; border: 1px solid #e2e4e9; border-radius: 8px; margin-bottom: 14px; overflow: hidden; }
        .card h2 { font-size: 15px; margin: 0; padding: 10px 14px; background: #eef1f5; color: #374151; }
        .body { padding: 14px; }
        table { width: 100%; border-collapse: collapse; font-size: 14px; }
        th, td { text-align: left; padding: 8px; border-bottom: 1px solid #eef0f3; }
        th { font-size: 12px; color: #6b7280; }
        .off { opacity: .45; text-decoration: line-through; }
        .btn { display: inline-block; padding: 8px 14px; border-radius: 6px; border: 1px solid transparent;
               font-size: 14px; cursor: pointer; text-decoration: none; background: #fff; color: #23272f; }
        .btn-primary { background: #2b6cb0; color: #fff; }
        .inline { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end; }
        .inline > div { flex: 1 1 130px; }
        label { display: block; font-size: 12px; color: #6b7280; margin-bottom: 4px; }
        input[type=text] { width: 100%; padding: 8px 10px; border: 1px solid #cbd2dc;
                          border-radius: 6px; font-size: 15px; font-family: inherit; }
        .muted { color: #8a93a0; font-size: 12px; }
    </style>
</head>
<body>
    <header>
        <a href="/orders" class="btn" style="color:#23272f">&larr; Наряды</a>
        <h1>Справочник материалов</h1>
        <span class="who"><%= currentUser %></span>
    </header>

    <main>
        <div class="card">
            <h2>Добавить материал</h2>
            <div class="body">
                <form method="post" action="/orders/catalog/materials" class="inline">
                    <div style="flex:2 1 200px"><label>Название</label><input type="text" name="name" required maxlength="120" placeholder="Диск циркониевый"></div>
                    <div><label>Категория</label><input type="text" name="category" maxlength="60" placeholder="Фрезерование"></div>
                    <div style="flex:0 0 80px"><label>Ед.</label><input type="text" name="unit" value="шт"></div>
                    <div style="flex:2 1 180px"><label>Примечание</label><input type="text" name="note" maxlength="300"></div>
                    <button class="btn btn-primary" type="submit">Добавить</button>
                </form>
                <p class="muted" style="margin:10px 0 0">Список общий для лаборатории. Техник может вписать материал прямо в наряд, даже если его нет здесь.</p>
            </div>
        </div>

        <div class="card">
            <h2>Материалы (<%= materials.length %>)</h2>
            <div class="body">
                <% if (!materials.length) { %>
                    <p class="muted">Справочник пуст</p>
                <% } else { %>
                <table>
                    <thead><tr><th>Название</th><th>Категория</th><th>Ед.</th><th>Примечание</th><th></th></tr></thead>
                    <tbody>
                    <% materials.forEach(m => { %>
                    <tr>
                        <td colspan="5" style="padding:0">
                            <details>
                                <summary style="cursor:pointer;padding:8px 12px;list-style:none">
                                    <span class="<%= m.active ? '' : 'off' %>"><%= m.name %></span>
                                    <span class="muted" style="font-size:12px"> — <%= m.category || 'без категории' %>, <%= m.unit %><%= m.active ? '' : ' · скрыт' %></span>
                                </summary>
                                <form method="post" action="/orders/catalog/materials/<%= m.id %>" style="padding:8px 12px 12px;border-top:1px solid var(--border)">
                                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                                        <div style="flex:2 1 200px"><label>Название</label><input type="text" name="name" value="<%= m.name %>" maxlength="120"></div>
                                        <div style="flex:1 1 130px"><label>Категория</label><input type="text" name="category" value="<%= m.category || '' %>" maxlength="60"></div>
                                        <div style="flex:0 0 90px"><label>Ед.</label><input type="text" name="unit" value="<%= m.unit %>" maxlength="20"></div>
                                        <div style="flex:3 1 220px"><label>Примечание</label><input type="text" name="note" value="<%= m.note || '' %>" maxlength="300"></div>
                                    </div>
                                    <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
                                        <button class="btn btn-primary" type="submit">Сохранить</button>
                                    </div>
                                </form>
</details>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td colspan="4" style="text-align:right;white-space:nowrap">
                                <form method="post" action="/orders/catalog/materials/<%= m.id %>/toggle" style="display:inline">
                                    <button class="btn" type="submit"><%= m.active ? 'Скрыть' : 'Вернуть' %></button>
                                </form>
                                <form method="post" action="/orders/catalog/materials/<%= m.id %>/delete" style="display:inline"
                                      onsubmit="return confirm('Скрыть материал «<%= m.name %>»? Он останется в старых нарядах.')">
                                    <button class="btn" type="submit">Убрать</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>
    </main>
</body>
</html>
