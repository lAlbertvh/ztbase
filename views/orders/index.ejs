<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FF9800">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <link rel="icon" href="/icons/icon-192.png">
    <title>Заказ-наряды</title>
    <link rel="stylesheet" href="/css/app.css">
    <style>
        /* Только то, что есть лишь в этом экране. Общие кнопки, поля,
           таблицы и шапка — в /css/app.css, чтобы разделы выглядели
           одинаково, а не каждый по-своему. */
        .tiles { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
        .tile {
            flex: 1 1 108px; background: #fff; border-radius: 8px; padding: 10px 12px;
            border: 1px solid #e2e4e9; text-decoration: none; color: inherit;
        }
        .tile.active { border-color: #FF9800; box-shadow: 0 0 0 2px rgba(255,152,0,.22); }
        .tile .n { font-size: 24px; font-weight: 700; line-height: 1.1; }
        .tile .t { font-size: 12px; color: #6b7280; margin-top: 2px; }
        .filters {
            display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px;
            background: #fff; padding: 12px; border-radius: 8px; border: 1px solid #e2e4e9;
        }
        .filters input[type=search] { flex: 1 1 200px; }
        .num { font-weight: 600; white-space: nowrap; }
    </style>
</head>
<body>
    <header class="app-header">
        <h1>Заказ-наряды</h1>
        <% if (!isDentist) { %>
            <a href="/orders/catalog/materials" class="btn btn-sm">Материалы</a>
            <a href="/orders/catalog/manipulations" class="btn btn-sm">Манипуляции</a>
            <a href="/orders/stats/manipulations" class="btn btn-sm">Отчёт</a>
        <% } %>
        <a href="/orders/new" class="btn btn-brand">✚ Новый наряд</a>
        <span class="who"><%= currentUser %><% if (!isDentist) { %> · <a href="/logout">выход</a><% } %></span>
    </header>

    <main>
    <%- include('../partials/nav', { active: 'orders', inline: false, currentUser, isDentist }) %>
        <% if (!isDentist) { %>
        <div class="tiles">
            <a class="tile <%= !filters.stage ? 'active' : '' %>" href="/orders">
                <div class="n"><%= summary.new + summary.taken + summary.review + summary.milled + summary.baked + summary.finished + summary.issued %></div>
                <div class="t">Все в работе</div>
            </a>
            <% stages.filter(s => s.key !== 'cancelled').forEach(s => { %>
                <a class="tile <%= filters.stage === s.key ? 'active' : '' %>" href="/orders?stage=<%= s.key %>">
                    <div class="n"><%= summary[s.key] %></div>
                    <div class="t"><%= s.short %></div>
                </a>
            <% }); %>
        </div>
        <% } %>

        <form class="filters" method="get" action="/orders">
            <input type="search" name="search" placeholder="Номер, заказчик или пациент"
                   value="<%= filters.search || '' %>" autocomplete="off">
            <% if (filters.stage) { %><input type="hidden" name="stage" value="<%= filters.stage %>"><% } %>
            <input type="date" name="date_from" value="<%= filters.date_from || '' %>" title="с даты">
            <input type="date" name="date_to" value="<%= filters.date_to || '' %>" title="по дату">
            <button class="btn btn-primary" type="submit">Найти</button>
            <a class="btn" href="/orders">Сбросить</a>
        </form>

        <% if (!orders.length) { %>
            <div class="empty">
                <p><strong>Нарядов нет</strong></p>
                <p>Создайте первый: <a href="/orders/new">новый заказ-наряд</a></p>
            </div>
        <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>№ наряда</th>
                    <th>Заказчик</th>
                    <th>Зубы</th>
                    <th class="hide-sm">Работы</th>
                    <th class="hide-sm">Создан</th>
                    <th>Этап</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            <% orders.forEach(o => { %>
                <tr>
                    <td class="num">
                        <% if (o.priority) { %><span class="prio" title="Срочный">!</span> <% } %>
                        <a href="/orders/<%= o.id %>" style="color:#2b6cb0;text-decoration:none"><%= o.order_number %></a>
                    </td>
                      <td>
                          <%# Клиника — главный признак, кому принадлежит работа,
                              поэтому она выше свободного текста заказчика. %>
                          <%= o.clinic_name || o.customer || '—' %>
                          <% if (o.patient) { %><div class="muted"><%= o.patient %></div><% } %>
                      </td>
                    <td class="num"><%= o.teeth_list || (o.teeth_count + ' зуб.') %></td>
                    <td class="hide-sm muted">
                        <% (o.kinds || '').split(',').filter(Boolean).forEach(k => { %><%= workTitle[k] || k %><% }); %>
                    </td>
                    <td class="hide-sm muted"><%= (o.created_at || '').slice(0, 10) %></td>
                    <td><span class="badge s-<%= o.stage %>"><%= stageShort[o.stage] || o.stage %></span></td>
                    <td style="white-space:nowrap">
                        <a class="btn" href="/orders/<%= o.id %>/print" title="Печать">⎙</a>
                    </td>
                </tr>
            <% }); %>
            </tbody>
        </table>
        <% if (total > limit) { %>
            <% const curPage = Math.floor(offset / limit) + 1;
               const lastPage = Math.ceil(total / limit);
               const link = (p) => '?' + new URLSearchParams({ ...filters, limit, offset: (p - 1) * limit }).toString(); %>
            <div style="display:flex;gap:8px;align-items:center;margin-top:12px;flex-wrap:wrap">
                <% if (curPage > 1) { %>
                <a class="btn" href="<%= link(curPage - 1) %>">&larr; Назад</a>
                <% } %>
                <span class="muted">Стр. <%= curPage %> из <%= lastPage %> · показано <%= orders.length %> из <%= total %></span>
                <% if (curPage < lastPage) { %>
                <a class="btn" href="<%= link(curPage + 1) %>">Вперёд &rarr;</a>
                <% } %>
            </div>
        <% } %>
        <% } %>
    </main>
</body>
</html>
