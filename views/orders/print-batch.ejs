<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Наряды — печать</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 8mm; color: #000; font-size: 11pt; }
        h1 { text-align: center; font-size: 15pt; margin: 0 0 2mm; }
        .sub { text-align: center; font-size: 10pt; margin-bottom: 5mm; }
        /* Каждый наряд начинается с новой страницы: на производстве
           бланки разбирают по одному и раскладывают по рабочим местам. */
        .order { page-break-after: always; break-after: page; margin-bottom: 6mm; }
        .order:last-child { page-break-after: auto; break-after: auto; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 3mm; }
        th, td { border: 1px solid #000; padding: 1.6mm 2mm; vertical-align: top; }
        th { background: #e8e8e8; font-size: 9.5pt; text-align: left; }
        .kv td.k { background: #f4f4f4; width: 22%; }
        .teeth td { text-align: center; padding: 1mm; }
        .teeth td.on { background: #111; color: #fff; font-weight: bold; }
        .num { font-size: 12pt; font-weight: bold; margin: 0 0 2mm; }
        .no-print { margin-bottom: 4mm; }
        .no-print button { padding: 6px 14px; font-size: 13px; cursor: pointer;
                           border: 1px solid #888; background: #f4f4f4; border-radius: 4px; }
        @media print { .no-print { display: none; } @page { size: A4; margin: 10mm; } }
    </style>
</head>
<body>
    <div class="no-print">
        <button onclick="window.print()">Печать всех</button>
        <button onclick="history.back()">Назад</button>
    </div>

    <h1>ЗАКАЗ-НАРЯДЫ</h1>
    <div class="sub">ZT Lab · <%= orders.length %> шт. · <%= new Date().toLocaleString('ru-RU') %></div>

    <% orders.forEach(order => { %>
    <div class="order">
        <div class="num">№ <%= order.order_number %></div>
        <table class="kv">
            <tr>
                <td class="k">Клиника</td><td><%= order.customer || '' %></td>
                <td class="k">Телефон</td><td><%= order.phone || '' %></td>
            </tr>
            <tr>
                <td class="k">Пациент</td><td><%= order.patient || '' %></td>
                <td class="k">Дата приёма</td><td><%= (order.created_at || '').slice(0, 10) %></td>
            </tr>
        </table>

        <table class="teeth">
            <% const marked = new Set(order.teeth.map(t => t.tooth)); %>
            <tr>
                <% catalog.QUADRANTS.forEach((q, qi) => {
                    q.teeth.forEach(t => { %><td class="<%= marked.has(t) ? 'on' : '' %>"><%= t %></td><% });
                    if (qi === 1) { %></tr><tr><% } %>
                <% }); %>
            </tr>
        </table>

        <% const t0 = order.teeth[0]; %>
        <table class="kv">
            <tr>
                <td class="k">Вид работ</td><td><%= t0 ? (catalog.WORK_TITLE[t0.kind] || t0.kind) : '' %></td>
                <td class="k">Материал</td><td><%= t0 ? (t0.material || '') : '' %></td>
            </tr>
            <% if (order.delivery) { %>
            <tr>
                <td class="k">Изготовить</td>
                <td colspan="3"><%= order.delivery.split(',').filter(Boolean).map(k => catalog.DELIVERY_TITLE[k] || k).join(', ') %></td>
            </tr>
            <% } %>
            <% if (order.materials.length) { %>
            <tr>
                <td class="k">Материалы</td>
                <td colspan="3"><%= order.materials.map(m => m.name + ' × ' + m.qty + ' ' + m.unit).join('; ') %></td>
            </tr>
            <% } %>
            <% if (order.comment) { %>
            <tr><td class="k">Комментарий</td><td colspan="3"><%= order.comment %></td></tr>
            <% } %>
        </table>

        <table>
            <tr><th style="width:34%">Этап</th><th style="width:20%">Дата</th><th>Сотрудник / заметка</th></tr>
            <% order.stages.slice(0, 4).forEach(s => { %>
            <tr>
                <td><%= catalog.STAGE_TITLE[s.stage] || s.stage %></td>
                <td><%= (s.created_at || '').slice(5, 16) %></td>
                <td><%= [s.user, s.note].filter(Boolean).join(' — ') %></td>
            </tr>
            <% }); %>
        </table>

        <div style="display:flex;gap:6mm;margin-top:6mm;font-size:10pt">
            <div style="flex:1;border-top:1px solid #000;padding-top:1.5mm">Принял</div>
            <div style="flex:1;border-top:1px solid #000;padding-top:1.5mm">Выполнил</div>
            <div style="flex:1;border-top:1px solid #000;padding-top:1.5mm">Проверил</div>
        </div>
    </div>
    <% }); %>
</body>
</html>
