<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#4CAF50">
    <title>Новый пароль — ZT Lab</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: Arial, sans-serif; margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #f5f5f5; padding: 16px; }
        .container { max-width: 400px; width: 100%; padding: 24px; background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h1 { text-align: center; font-size: 22px; color: #333; margin-top: 0; }
        input, button { width: 100%; padding: 12px; margin: 8px 0; font-size: 16px; border-radius: 6px; }
        input { border: 1px solid #ccc; }
        button { background: #4CAF50; color: white; border: none; cursor: pointer; }
        button:hover { background: #45a049; }
        button:focus, input:focus { outline: 2px solid #4CAF50; }
        .error { background: #ffebee; color: #c62828; padding: 10px; border-radius: 6px; margin: 10px 0; font-size: 14px; }
        .done { background: #e8f5e9; color: #1b5e20; padding: 12px; border-radius: 6px; margin: 10px 0; font-size: 14px; }
        .muted { color: #777; font-size: 13px; text-align: center; margin-top: 20px; }
        .muted a { color: #4CAF50; }
        label { font-size: 13px; color: #555; display: block; margin-bottom: 2px; }
        .hint { font-size: 13px; color: #777; margin: 0 0 4px; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Новый пароль</h1>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <% if (done) { %>
            <div class="done">
                Пароль изменён. Теперь войдите с адресом лаборатории, своим именем
                и новым паролем.
            </div>
        <% } else if (token) { %>
            <form method="post" action="/password/set">
                <input type="hidden" name="token" value="<%= token %>">
                <label for="password">Новый пароль (не короче 6 символов)</label>
                <input type="password" id="password" name="password" required minlength="6" autocomplete="new-password" autofocus>
                <label for="password2">Ещё раз</label>
                <input type="password" id="password2" name="password2" required minlength="6" autocomplete="new-password">
                <button type="submit">Сохранить пароль</button>
            </form>
        <% } %>
        <div class="muted">
            <a href="/login">Вернуться ко входу</a>
        </div>
    </div>
</body>
</html>
