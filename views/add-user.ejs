<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#2196F3">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icons/icon-192.png">
    <title>Добавление пользователя</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: Arial, sans-serif; margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #f5f5f5; padding: 16px; }
        .container { max-width: 400px; width: 100%; padding: 24px; background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h1 { text-align: center; font-size: 22px; color: #333; }
        input, button { width: 100%; padding: 12px; margin: 10px 0; font-size: 16px; border-radius: 6px; }
        input, select { border: 1px solid #ccc; }
        button { background: #4CAF50; color: white; border: none; cursor: pointer; }
        button:hover { background: #45a049; }
        .error { color: #d32f2f; background: #ffebee; padding: 10px; border-radius: 6px; }
          .counter { color: #555; background: #f2f4f7; padding: 8px 10px; border-radius: 6px; font-size: 13px; }
        .back { text-align: center; margin-top: 20px; }
        .back a { color: #2196F3; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
<h1>Добавить нового пользователя</h1>
          <% if (typeof usage !== 'undefined' && usage) { %>
              <p class="counter">
                  Тариф «<%= usage.plan.title %>»: <%= usage.max %> мест,
                  занято <%= usage.used %>
                  <% if (usage.over > 0) { %>
                      <span style="color:#d32f2f">— превышение на <%= usage.over %></span>
                  <% } %>
              </p>
          <% } %>
          <% if (typeof warning !== 'undefined' && warning) { %>
              <p class="error"><%= warning %></p>
          <% } %>
          <% if (error) { %>
              <p class="error"><%= error %></p>
          <% } %>
        <form method="post" action="/add-user">
            <input type="text" name="newUsername" placeholder="Имя сотрудника" required>
            <input type="password" name="password" placeholder="Пароль сотрудника" required minlength="6">
            <select name="role" data-spec-select>
                <option value="tech">Техник</option>
                <option value="admin">Администрация</option>
            </select>
            <select name="specialization" data-spec-target></select>
            <button type="submit">Добавить</button>
        </form>
        <div class="back"><a href="/">← Вернуться на главную</a></div>
      <script>
      // Специализация одна на роль: варианты подставляются из данных
      // страницы, поэтому «Бухгалтер» в списке техника не появится.
      (function () {
        var ALL = <%- JSON.stringify(typeof specializations !== 'undefined' ? specializations : {}) %>;
        var roleSel = document.querySelector('[data-spec-select]');
        var specSel = document.querySelector('[data-spec-target]');
        if (!roleSel || !specSel) return;
        function fill() {
          var list = ALL[roleSel.value] || [];
          specSel.innerHTML = '<option value="">Специализация не указана</option>' + list.map(function (item) {
            return '<option value="' + item[0] + '">' + item[1] + '</option>';
          }).join('');
        }
        roleSel.addEventListener('change', fill);
        fill();
      })();
      </script>
    </div>
</body>
</html>
