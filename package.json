{
  "name": "exostart",
  "version": "1.1.0",
  "description": "Хранилище 3D-файлов и учёт титановых оснований для зуботехнической лаборатории",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "build:linux": "pkg server.js --targets node20-linux-x64 --output dist/exo-linux",
    "build:win": "pkg server.js --targets node20-win-x64 --output dist/exo-win.exe",
    "build:mac": "pkg server.js --targets node20-macos-x64 --output dist/exo-macos",
    "build": "npm run build:linux && npm run build:win && npm run build:mac",
    "pkg": "pkg server.js"
  },
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/better-sqlite3/lib/**/*",
      "views/**/*",
      "public/**/*"
    ],
    "scripts": [
      "server.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.2"
  }
}