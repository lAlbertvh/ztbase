{
  "name": "ztlab",
  "version": "2.0.0",
  "description": "ZT Lab — хранение 3D-файлов и учёт титановых оснований для зуботехнических лабораторий",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "test": "node test/manipulations-unit.js && node test/orders-live.js && node test/setup-live.js && node test/chat-live.js && node test/clinics-live.js",
    "test:unit": "node test/manipulations-unit.js",
    "test:live": "node test/orders-live.js",
    "test:chat": "node test/chat-live.js",
    "test:clinics": "node test/clinics-live.js",
    "start": "node server.js",
    "build:linux": "pkg server.js --targets node22-linux-x64 --output dist/exo-linux",
    "build:win": "pkg server.js --targets node22-win-x64 --output dist/exo-win.exe",
    "build:mac": "pkg server.js --targets node22-macos-x64 --output dist/exo-macos",
    "build": "npm run build:linux && npm run build:win && npm run build:mac",
    "pkg": "pkg server.js"
  },
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/better-sqlite3/lib/**/*",
      "views/**/*",
      "public/**/*"
    ],
    "scripts": [
      "server.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "better-sqlite3": "12.6.0",
    "dotenv": "17.3.1",
    "ejs": "4.0.1",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "multer": "2.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.14.2"
  },
  "allowScripts": {
    "better-sqlite3@12.6.0": true,
    "esbuild@0.27.7": true
  },
  "engines": {
    "node": "22.x"
  }
}
