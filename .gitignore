# Данные приложения (не попадают в git)
database/
uploads/
tmp-uploads/

# Страховка от попадания базы в репозиторий: даже если она окажется
# вне database/ (тестовый прогон, копия), такой файл не должен уехать
# на GitHub вместе с кодом.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Зависимости и сборки
node_modules/
dist/
prebuilds/

# Логи и временные файлы
*.log
.DS_Store

# Переменные окружения с секретами.
# .env.example под этот шаблон не подпадает: его положено хранить в репозитории.
.env
.env.local
.env.*.local
