# Порт веб-сервера (по умолчанию 3000)
PORT=3000

# Секрет для сессий. ОБЯЗАТЕЛЬНО замените: строка из 32+ случайных символов
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-strong-secret-key-here

# Секрет для подписи сессий в cookie
# (в продакшене задайте то же значение, что и SESSION_SECRET)

# ------ Хранилище файлов ------
# local — файлы на диске (по умолчанию, подходит для VPS с диском 100+ ГБ)
# s3    — объектное хранилище (Yandex, Selectel, Timeweb, VK Cloud)
STORAGE_BACKEND=local

# Куда класть файлы при STORAGE_BACKEND=local
# UPLOAD_DIR=/var/lib/ztlab/uploads

# ------ Настройки S3 (нужны только при STORAGE_BACKEND=s3) ------
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=ztlab-files
# S3_KEY_ID=
# S3_KEY_SECRET=

# ------ Сколько гигабайт файлов хранится одновременно (для расчёта лимитов) ------
STORAGE_QUOTA_GB=100
