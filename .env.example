# Порт веб-сервера (по умолчанию 3000)
PORT=3000

# Режим работы: development | production
# В production приложение не запустится со слабым или пустым SESSION_SECRET.
NODE_ENV=development

# Секрет для подписи cookie сессий. ОБЯЗАТЕЛЬНО замените.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Если не задать, в development будет использован временный ключ
# (сессии сбрасываются при перезапуске, зато подделать их нельзя).
SESSION_SECRET=

# Ставить 1, когда сайт работает через HTTPS (nginx + Let's Encrypt).
# Иначе браузер не примет cookie и вход будет сбрасываться.
COOKIE_SECURE=0

# ------ Хранилище файлов ------
# local — файлы на диске ноутбука (по умолчанию)
# s3    — объектное хранилище (Yandex, Selectel, Timeweb, VK Cloud)
STORAGE_BACKEND=local

# Куда класть файлы при STORAGE_BACKEND=local
# UPLOAD_DIR=/home/albert/ztlab/uploads

# ------ Настройки S3 (нужны только при STORAGE_BACKEND=s3) ------
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_REGION=ru-central1
# S3_BUCKET=ztlab-files
# S3_KEY_ID=
# S3_KEY_SECRET=

# ------ Лимиты ------
# Сколько гигабайт файлов хранится одновременно (для расчёта тарифов)
STORAGE_QUOTA_GB=100

# ------ Одноразовая миграция ------
# Временный пароль для сотрудников, перенесённых из старой базы
# без паролей. Задайте один раз при первом запуске со старым files.db,
# затем удалите переменную. Пустое значение = перенос без паролей.
MIGRATION_TEMP_PASSWORD=
